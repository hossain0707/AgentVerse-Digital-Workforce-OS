AGENTVERSE_DEMO=0
AGENTVERSE_DB=./data/agentverse.db
# Required for non-demo deployment. Use a strong random key and HTTPS.
AGENTVERSE_SECRET=replace_with_strong_random_secret
# Optional. Real AI tasks require a compatible chat-completions model service.
# AGENTVERSE_MODEL_KEY=your_provider_api_key
# AGENTVERSE_MODEL_NAME=gpt-4.1-mini
# AGENTVERSE_MODEL_URL=https://api.openai.com/v1/chat/completions

# Public registration stays disabled by default until identity verification exists.
AGENTVERSE_ALLOW_REGISTRATION=0